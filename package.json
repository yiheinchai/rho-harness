{
  "name": "rho-harness",
  "version": "0.1.0",
  "description": "Production customer-workflow harness forked from the Pi/OpenCode agent model for enterprise guest experiences.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "tsx src/cli.ts serve",
    "dev": "tsx watch src/cli.ts serve",
